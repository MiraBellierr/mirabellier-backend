### Backend environment example
# Copy this to `mirabellier-backend/.env` (which should be ignored) and set your values.

# Port the backend server listens on
PORT=3000

# Optional: override the SQLite DB file path
DB_FILE=./database.sqlite3

# Secret used to sign session tokens or other secrets (set in production)
SESSION_SECRET=your-very-secret-value

# Private Cloudflare Turnstile key used only by the backend.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Comma-separated hostnames accepted from Cloudflare Siteverify.
TURNSTILE_ALLOWED_HOSTNAMES=mirabellier.com,www.mirabellier.com
# Owner authorization (server-side). Comma-separated list for multiple owner/admin Discord IDs.
OWNER_DISCORD_IDS=548050617889980426
# Optional: cookie name for httpOnly auth sessions
SESSION_COOKIE_NAME=mirabellier_session
# Optional: cookie lifetime in seconds (default 30 days)
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
# Optional: force Secure attribute on/off. If unset, backend auto-detects from request scheme.
# SESSION_COOKIE_SECURE=true

# Directory for image storage. Can be absolute or relative to the backend folder.
# If unset, defaults to the `images` directory next to the backend.
IMAGES_DIR=images

# Discord OAuth Configuration
# Create a Discord application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Frontend URL for redirects after Discord OAuth
FRONTEND_URL=http://localhost:5173

# MyAnimeList currently-watching sync
# Uses the public username anime list endpoint with client-id auth, not MAL OAuth.
MAL_CLIENT_ID=your_myanimelist_client_id
MAL_USERNAME=your_myanimelist_username
# Optional: how long the backend should cache the MAL feed before refreshing it again.
MAL_ANIME_REFRESH_MINUTES=5

# Twitch stream predictions (/twitch page)
# Create an app at https://dev.twitch.tv/console to get these.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
# Optional: how often live status / viewer counts are polled (seconds, min 10). Defaults to 20.
# TWITCH_POLL_INTERVAL_SECONDS=20

# Web Push (VAPID) for "notify me when live" on /twitch.
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@mirabellier.com

# Fan art search (Safebooru + Gelbooru work without any credentials; Pixiv needs a token).
# Optional: Gelbooru API key + user id (required for Gelbooru search in most regions).
# GELBOORU_API_KEY=your_gelbooru_api_key
# GELBOORU_USER_ID=your_gelbooru_user_id
# Optional: Danbooru API key + username (works anonymously without them, but the key
# lifts rate limits and unlocks all posts). Generate the key at
# https://danbooru.donmai.us/profile ("API Key" section, 40 characters).
# DANBOORU_LOGIN must be your Danbooru username (the name shown on your profile),
# not your numeric user id.
# DANBOORU_API_KEY=your_danbooru_api_key
# DANBOORU_LOGIN=your_danbooru_username
# Optional: Pixiv refresh token for search. Without it, Pixiv is reported as unconfigured.
# PIXIV_REFRESH_TOKEN=your_pixiv_refresh_token
# Optional: how long fan art search results are cached in memory (seconds). Defaults to 300.
# FANART_CACHE_TTL_SECONDS=300
# Optional: override the ranked local character catalog used by Arena card draws.
# MAL_CHARACTERS_FILE=./data/mal-characters.json

# Optional: shift the Arena "day" boundary (card draws, shop offers, daily
# defender caps) by this many minutes relative to UTC. Defaults to 0 (UTC midnight).
# ARENA_DAY_UTC_OFFSET_MINUTES=-300

# Optional: Discord webhook for Question of the Day drops.
# Create the webhook in your Discord channel settings, then paste the URL here.
QOTD_DISCORD_WEBHOOK_URL=
# Optional: override the webhook display name/avatar for QOTD posts
QOTD_DISCORD_WEBHOOK_USERNAME=Mirabellier QOTD
# QOTD_DISCORD_WEBHOOK_AVATAR_URL=https://example.com/qotd-avatar.png

# Optional: schedule the daily quote refresh in UTC. Defaults to 00:00.
# QUOTE_FETCH_HOUR_UTC=0
# QUOTE_FETCH_MINUTE_UTC=0

# Public website base URL used for canonicals, sitemap entries, and IndexNow.
WEBSITE_BASE=https://mirabellier.com

# IndexNow
# Generate a key, then the backend will publish it as `https://your-site/<key>.txt`
# and notify IndexNow whenever blog posts are created, edited, or deleted.
INDEXNOW_KEY=your-indexnow-key
# Optional: disable submissions without removing the key
# INDEXNOW_ENABLED=false
# Optional: override the official endpoint for debugging
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# TikTok → Pixies admin fetch (/admin/tiktok).
# Optional but recommended: paste the value of your `ttwid` cookie from tiktok.com
# (browser DevTools → Application → Cookies while logged in on tiktok.com).
# Without it, TikTok often refuses the page fetch.
TIKTOK_TTWID=
# Optional but strongest: a full cookie export from a LOGGED-IN tiktok.com
# session (Netscape cookies.txt format, e.g. from a "Get cookies.txt" browser
# extension). Used for page scrapes, the direct video download, and passed to
# yt-dlp. TikTok's CDN often refuses downloads with only a ttwid cookie.
# Defaults to ./data/tiktok-cookies.txt when that file exists.
# TIKTOK_COOKIES_FILE=./data/tiktok-cookies.txt

# Optional: same idea, but for Instagram (log in at instagram.com and export
# cookies). Instagram now login-walls almost everything anonymously — without
# this file, resolving avatars (and often reels themselves) fails from most
# server IPs. Used for profile avatar fetches and passed to yt-dlp.
# Defaults to ./data/instagram-cookies.txt when that file exists.
# INSTAGRAM_COOKIES_FILE=./data/instagram-cookies.txt

# Optional: same idea, but for YouTube (log in at youtube.com and export
# cookies). YouTube asks "Sign in to confirm you're not a bot" for anonymous
# server-IP requests; a logged-in export avoids that. Passed to yt-dlp.
# IMPORTANT: the export must come from a browser that is actually SIGNED IN —
# a logged-out session (no SID/SSID) is still rejected from datacenter IPs.
# Defaults to ./data/youtube-cookies.txt when that file exists.
# YOUTUBE_COOKIES_FILE=./data/youtube-cookies.txt

# Optional: YouTube also bot-walls datacenter IPs even with cookies. Run
# scripts/setup-youtube-pot-provider.sh (as root) to install the bgutil
# Proof-of-Origin provider (Docker) + the yt-dlp plugin that auto-fetches
# tokens from it. Only set this if you run the provider on a non-default
# address (the plugin defaults to http://127.0.0.1:4416):
# YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416

# Social video import (/admin/import) for Instagram and YouTube, and as a
# fallback when TikTok refuses its direct download URL.
# Install yt-dlp on the server (https://github.com/yt-dlp/yt-dlp). Optional
# override for the binary path:
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Optional: max size (MB) of an imported video before it is rejected. Defaults to 200.
# VIDEO_IMPORT_MAX_MB=200
